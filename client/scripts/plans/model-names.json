  {
    "name": "U42-3-offline",
    "steps": [
      [
        "wait",
        1200
      ],
      [
        "eval",
        "window.__sim.offline('Cannot reach the computer. Check its address and private network.')"
      ],
      [
        "wait",
        2500
      ],
      [
        "clickSel",
        "button.status"
      ],
      [
        "wait",
        600
      ],
      [
        "eval",
        "const e=[...document.querySelectorAll('dialog[open] *')].filter(e=>e.textContent.startsWith('Cannot reach the computer')).at(-1);if(!e)throw Error('Missing reason');const d=e.textContent;if(!/^Cannot reach the computer\\. Check its address and private network\\. Last heard (just now|.+ ago)\\. Trying again (now|in .+)\\.$/.test(d))throw Error('Unexpected detail: '+d);if(/[.!?…]\\s*[.!?]/.test(d))throw Error('Doubled punctuation: '+d)"
      ]
    ]
  },
