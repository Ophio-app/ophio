[
  {
    "name": "U42-1-talk",
    "steps": [
      [
        "eval",
        "(async()=>{const {UiStore}=await import('/src/app/ui.ts');const {ids}=await import('/src/dev/sim/scenario.ts');const ui=new UiStore('sim-studio');ui.selectTask(ids.pTide,ids.tFlaky);ui.selectTab('talk');window.addEventListener('pagehide',()=>ui.persistNow(),{once:true});location.reload()})()"
      ],
      [
        "wait",
        1500
      ],
      [
        "eval",
        "(async()=>{const {ids}=await import('/src/dev/sim/scenario.ts');const h=window.__sim.host;const r=h.runs.find(r=>r.run_id===ids.rFlaky);const next={...r,requested_model:'opus',actual_model:'claude-opus-5-5'};h.runs=h.runs.map(x=>x.run_id===r.run_id?next:x);h.emit({type:'run_upserted',run:next})})()"
      ],
      [
        "wait",
        600
      ],
      [
        "eval",
        "const t=document.body.textContent;if(!t.includes(\"Claude Code \\u00b7 Opus 5.5\"))throw Error('Missing '+\"Claude Code \\u00b7 Opus 5.5\");if(t.includes(\"Claude Code \\u00b7 Claude\"))throw Error('Unexpected '+\"Claude Code \\u00b7 Claude\");"
      ]
    ]
  },
