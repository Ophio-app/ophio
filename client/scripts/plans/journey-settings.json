[
  {
    "name": "m3-settings-light",
    "width": 390,
    "height": 844,
    "scale": 1,
    "settle": 900,
    "steps": [
      ["clickSel", ".ctx__context"],
      ["click", "Connections and readiness"],
      ["wait", 600],
      ["click", "Export phone data"],
      ["wait", 350],
      [
        "eval",
        "if(!window.__sim.device.downloads.some(d=>d.name==='phone-data.json'&&d.size>0)) throw Error('Export was not saved'); document.querySelector('#settings-data').scrollIntoView({block:'center'})"
      ],
      ["shot", "export"],
      ["click", "Export phone data"],
      ["wait", 250],
      [
        "eval",
        "if(!window.__sim.device.downloads.some(d=>d.name==='phone-data (1).json')) throw Error('Second export overwrote first')"
      ],
      ["click", "Open-source notices"],
      ["wait", 400],
      ["shot", "notices"],
      ["clickSel", "dialog[open] .sheet__header .iconbtn"],
      ["wait", 300],
      [
        "log",
        "({focus:document.activeElement?.textContent,downloads:window.__sim.device.downloads})"
      ]
    ]
  },
