  {
    "name": "continue-talk-390",
    "width": 390,
    "height": 844,
    "text": 2,
    "scale": 1,
    "settle": 900,
    "steps": [
      [
        "eval",
        "(async()=>{const {UiStore}=await import('/src/app/ui.ts');const ui=new UiStore('sim-studio');const h=window.__sim.host;const t=h.tasks.find(t=>t.kind==='computer_use');ui.selectTask(t.project_id,t.task_id);ui.saveDraft(t.project_id,t.task_id,{text:'Continue checking the desktop'});ui.reset('talk');ui.persistNow();location.reload()})()"
      ],
      [
        "wait",
        1200
      ],
      [
        "eval",
        "const h=window.__sim.host;const t=h.tasks.find(t=>t.kind==='computer_use');h.tasks=h.tasks.map(x=>x.task_id===t.task_id?{...x,state:'interrupted'}:x);h.runs=h.runs.map(r=>r.run_id===t.current_run?{...r,state:'interrupted'}:r);h.projects=h.projects.map(p=>p.project_id===t.project_id?{...p,active_writer:null}:p);h.control=h.control.map(c=>c.target_id===t.target_id?{...c,desktop_lock:'locked',input_state:'paused',lease:null}:c);h.tasks.forEach(task=>h.emit({type:'task_upserted',task}));h.runs.forEach(run=>h.emit({type:'run_upserted',run}));h.projects.forEach(project=>h.emit({type:'project_upserted',project}));h.control.forEach(view=>h.emit({type:'control_changed',view}));"
      ],
      [
        "wait",
        300
      ],
      [
        "eval",
        "if(!document.body.innerText.includes(\"Unlock on the computer to watch and control again.\")) throw new Error(\"Missing expected copy\")"
      ],
      [
        "eval",
        "const b=[...document.querySelectorAll('button')].find(b=>b.textContent.trim()==='Continue');if(!b?.disabled)throw new Error('Continue is enabled');b.scrollIntoView({block:'nearest'})"
      ]
    ]
  },
  {
