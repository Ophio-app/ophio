[
  {
    "name": "stale-save-390",
    "width": 390,
    "height": 844,
    "text": 2,
    "scale": 1,
    "settle": 900,
    "steps": [
      [
        "eval",
        "(async()=>{const {UiStore}=await import('/src/app/ui.ts');const ui=new UiStore('sim-studio');const h=window.__sim.host;ui.selectProject(h.projects[0].project_id);ui.push({screen:'connections'});ui.persistNow();location.reload()})()"
      ],
      [
        "wait",
        1200
      ],
      [
        "eval",
        "const h=window.__sim.host;h.devices=h.devices.map(d=>d.name==='Old tablet'?{...d,grants:{...d.grants,control_input:true,view:true,terminal:false}}:d);h.emit({type:'devices_changed',devices:h.devices})"
      ],
      [
        "click",
        "Permissions for Old tablet"
      ],
      [
        "eval",
        "(async()=>{const h=window.__sim.host;const d=h.devices.find(d=>d.name==='Old tablet');await h.command({command_id:crypto.randomUUID(),issued_at:Date.now(),expected_revision:null,expires_at:null,body:{command:'set_device_grants',device_id:d.device_id,expected:{...d.grants},grants:{...d.grants,control_input:false}}})})()"
      ],
      [
        "clickSel",
        "dialog[open] label:has-text(\"Terminals\") input"
      ],
      [
        "click",
        "Save permissions"
      ],
      [
        "wait",
        700
      ],
      [
        "eval",
        "if(!document.body.innerText.includes(\"This device's permissions changed while you were editing.\")) throw new Error(\"Missing expected copy\")"
      ],
      [
        "eval",
        "const d=window.__sim.host.devices.find(d=>d.name==='Old tablet');if(d.grants.control_input) throw new Error('Stale grant restored');document.querySelector('dialog[open] [role=alert]').scrollIntoView({block:'nearest'})"
      ]
    ]
  },
