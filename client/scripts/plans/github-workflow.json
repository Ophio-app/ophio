 {
  "name": "gh-review-light",
  "width": 390,
  "height": 844,
  "scale": 1,
  "settle": 900,
  "steps": [
   [
    "eval",
    "const h=window.__sim.host;const p={...h.projects.find(p=>p.name==='tidewater-api'),active_writer:null};h.projects=h.projects.map(x=>x.project_id===p.project_id?p:x);h.emit({type:'project_upserted',project:p})"
   ],
   [
    "clickSel",
    ".talk-bar__title"
   ],
   [
    "wait",
    700
   ],
   [
    "eval",
    "const clk=(re,n=0)=>{const b=[...document.querySelectorAll('button,a,[role=tab],[role=radio],summary,label')].filter(e=>e.offsetParent&&re.test((e.getAttribute('aria-label')||e.innerText).trim()))[n];if(!b)throw Error('No control '+re);b.click()};clk(/^New task\\s+Start something separate/,0)"
   ],
   [
    "wait",
    700
   ],
   [
    "fill",
    "What should",
    "Add a retry budget header"
   ],
   [
    "eval",
    "const clk=(re,n=0)=>{const b=[...document.querySelectorAll('button,a,[role=tab],[role=radio],summary,label')].filter(e=>e.offsetParent&&re.test((e.getAttribute('aria-label')||e.innerText).trim()))[n];if(!b)throw Error('No control '+re);b.click()};clk(/^Review$/,0)"
   ],
   [
    "wait",
    900
   ],
   [
    "eval",
    "if(!(document.querySelector('[aria-label=\"GitHub: New pull request\"]'))) throw Error(\"Work did not default to a new pull request\")"
   ],
   [
    "shot",
    "review"
   ],
   [
    "click",
    "GitHub: New pull request"
   ],
   [
    "wait",
    600
   ],
   [
    "shot",
    "links"
   ],
   [
    "eval",
    "const clk=(re,n=0)=>{const b=[...document.querySelectorAll('button,a,[role=tab],[role=radio],summary,label')].filter(e=>e.offsetParent&&re.test((e.getAttribute('aria-label')||e.innerText).trim()))[n];if(!b)throw Error('No control '+re);b.click()};clk(/^Take over a pull request/,0)"
   ],
   [
    "wait",
    900
   ],
   [
    "shot",
    "pr-step"
   ],
   [
    "fill",
    "The pull request\u2019s number or link",
    "#214"
   ],
   [
    "wait",
    200
   ],
   [
    "click",
    "Use #214"
   ],
   [
    "wait",
    600
   ],
   [
    "eval",
    "if(!(document.querySelector('[aria-label=\"GitHub: Pull request #214\"]'))) throw Error(\"Take over did not link #214\")"
   ]
  ]
 },
