[
 {
  "name": "gh-settings-light",
  "width": 390,
  "height": 844,
  "scale": 1,
  "settle": 900,
  "steps": [
   [
    "clickSel",
    ".ctx__context"
   ],
   [
    "click",
    "Connections and readiness"
   ],
   [
    "wait",
    600
   ],
   [
    "click",
    "App settings"
   ],
   [
    "wait",
    600
   ],
   [
    "click",
    "GitHub"
   ],
   [
    "wait",
    700
   ],
   [
    "shot",
    "projects"
   ],
   [
    "click",
    "tidewater-api"
   ],
   [
    "wait",
    900
   ],
   [
    "shot",
    "drafts"
   ],
   [
    "eval",
    "const clk=(re,n=0)=>{const b=[...document.querySelectorAll('button,a,[role=tab],[role=radio],summary,label')].filter(e=>e.offsetParent&&re.test((e.getAttribute('aria-label')||e.innerText).trim()))[n];if(!b)throw Error('No control '+re);b.click()};clk(/^Through merge/,0)"
   ],
   [
    "wait",
    900
   ],
   [
    "shot",
    "warning"
   ],
   [
    "eval",
    "document.querySelectorAll('dialog[open] *').forEach(e=>{if(e.scrollHeight>e.clientHeight+20&&getComputedStyle(e).overflowY!='visible')e.scrollTop=e.scrollHeight})"
   ],
   [
    "wait",
    200
   ],
   [
    "shot",
    "warning-end"
   ],
   [
    "click",
    "Keep Through merge"
   ],
   [
    "wait",
    900
   ],
   [
    "eval",
    "if(!([...document.querySelectorAll('*')].some(e=>e.children.length===0&&/merges its pull requests into .* once their checks pass/.test(e.textContent)))) throw Error(\"No Through merge reminder\")"
   ]
  ]
 },
