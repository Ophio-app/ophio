  {
    "name": "desktop-keyboard-short",
    "width": 360,
    "height": 420,
    "steps": [
      ["click", "Control"],
      ["wait", 600],
      ["click", "Watch HDMI-A-1"],
      ["wait", 700],
      ["click", "Enable control"],
      ["click", "Keyboard"],
      ["fill", "Text for the computer", "Keep this draft"],
      [
        "eval",
        "const b=[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Leave control')); const r=b.getBoundingClientRect(); if(r.bottom>innerHeight || r.top<0)throw Error('Leave control hidden')"
      ]
    ]
  },
  {
    "name": "agent-short",
    "width": 360,
    "height": 420,
    "steps": [
      ["click", "Control"],
      ["wait", 600],
      ["click", "Check the staging dashboard"],
      ["wait", 700],
      [
        "eval",
        "for(const text of ['Pause input','Take over','Stop task']) { const b=[...document.querySelectorAll('.safety-actions button')].find(b=>b.textContent.includes(text)); const r=b.getBoundingClientRect(); if(r.bottom>innerHeight || r.top<0)throw Error(text+' hidden'); }"
      ]
    ]
  },
