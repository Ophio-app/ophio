  {
    "name": "desktop-human-keyboard",
    "dark": true,
    "steps": [
      ["click", "Control"],
      ["wait", 600],
      ["click", "Watch HDMI-A-1"],
      ["wait", 700],
      [
        "eval",
        "if(window.__sim.control.inputs().length) throw Error('Opening sent input')"
      ],
      ["click", "Enable control"],
      ["wait", 400],
      ["clickSel", "[role=radio]:has-text('Direct')"],
      ["clickSel", ".picture-surface"],
      [
        "eval",
        "const c=window.__sim.control.inputs().filter(x=>x.action.action==='click'); if(c.length!==1 || Math.abs(c[0].action.at.x-.5)>.02 || Math.abs(c[0].action.at.y-.5)>.02) throw Error('Wrong click coordinates')"
      ],
      ["shot", "click"],
      ["click", "Keyboard"],
      ["fill", "Text for the computer", "A saved input draft"],
      ["shot", "draft"],
      ["click", "Leave control"],
      ["wait", 1500],
      [
        "eval",
        "if(window.__sim.host.control.some(x=>x.lease?.owner.kind==='human' && x.lease.state==='active')) throw Error('Lease not released')"
      ]
    ]
  },
  {
    "name": "desktop-stale",
    "steps": [
      ["click", "Control"],
      ["wait", 600],
      ["click", "Watch HDMI-A-1"],
      ["wait", 700],
      ["click", "Enable control"],
      ["eval", "window.__sim.media.freeze()"],
      ["wait", 4100],
      ["shot", "paused"],
      ["eval", "window.__sim.media.freeze(false)"],
      ["wait", 600],
      ["shot", "restored"]
    ]
  },
