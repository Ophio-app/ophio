        "const rail=document.querySelector('.safety-rail').getBoundingClientRect();const b=[...document.querySelectorAll('.an-screen button')].find(e=>e.textContent==='Review and send').getBoundingClientRect();const footer=document.querySelector('.an-review');if(b.top<0||b.bottom>rail.top||footer.scrollHeight>footer.clientHeight)throw Error('Review action needs a second scroll');"
      ]
