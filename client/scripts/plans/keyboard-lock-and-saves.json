        "log",
        "(()=>{const b=[...document.querySelectorAll('button')].find(b=>b.textContent==='Review and send');return {button:b?.getBoundingClientRect().toJSON(),footer:document.querySelector('.an-review')?.getBoundingClientRect().toJSON(),rail:document.querySelector('.safety-rail')?.getBoundingClientRect().toJSON()}})()"
