        "eval",
        "(async()=>{const {seedAnnotation}=await import('/src/dev/sim/annotate.ts');const id=await seedAnnotation(window.__sim.host,'comments');const {annotationStore}=await import('/src/state/annotations.ts');const store=annotationStore('sim-studio');store.record(id,d=>({...d,mode:'steps',expected:'The page loads',actual:'The page stays blank',sources:[...d.sources,{...d.sources[0],key:'clip',mediaType:'video/webm',included:false,origin:{kind:'clip',target_id:null,duration_ms:3000}}],steps:[{index:1,source_key:'S1',text:'Open the page',clip_range_ms:null}]}));const {UiStore}=await import('/src/app/ui.ts');const ui=new UiStore('sim-studio');ui.selectProject(window.__sim.host.projects[0].project_id);ui.push({screen:'annotate',annotationId:id});window.addEventListener('pagehide',()=>ui.persistNow(),{once:true});location.reload()})()"
