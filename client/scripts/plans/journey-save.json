[
  {
    "name": "m3-transfer-light",
    "scale": 1,
    "settle": 900,
    "steps": [
      ["click", "Library"],
      ["wait", 650],
      ["click", "Project · Read and write"],
      ["wait", 500],
      ["clickSel", "button.row:has-text(\"docs\")"],
      ["wait", 450],
      ["click", "metrics.csv"],
      ["wait", 450],
      ["click", "Send to this device"],
      ["wait", 1300],
      [
        "eval",
        "document.querySelector(\".route:not(.is-hidden) .transfer-row\")?.scrollIntoView({block:\"center\"})"
      ],
      ["wait", 400],
      ["shot", "verified"],
      ["click", "Save to phone"],
      ["wait", 700],
      ["log", "window.__sim.device.downloads"],
      ["shot", "saved"],
      ["click", "Save another copy"],
      ["wait", 350],
      [
        "eval",
        "if(!window.__sim.device.downloads.some(d=>d.name==='metrics (1).csv')) throw Error('Copy not saved')"
      ]
    ]
  },
