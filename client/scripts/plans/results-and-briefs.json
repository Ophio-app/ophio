        "eval",
        "window.__beforeTasks=window.__sim.host.tasks.map(t=>t.task_id); if(window.__sim.device.downloads.length!==1)throw Error('Brief save was not confirmed');"
      ],
      [
        "click",
        "Start task"
      ],
      [
        "wait",
        1000
      ],
      [
        "eval",
        "const t=window.__sim.host.tasks.find(t=>!window.__beforeTasks.includes(t.task_id)); if(!t||t.title!=='Follow-up: Refine the checkout page')throw Error('No fresh task created from the review');"
      ]
    ]
