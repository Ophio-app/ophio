[
  {
    "name": "offer-light",
    "scale": 1,
    "settle": 1000,
    "steps": [
      [
        "eval",
        "window.__sim.device.notificationPermission('promptable'); window.__sim.pace(100)"
      ],
      [
        "clickSel",
        ".ctx__context"
      ],
      [
        "click",
        "garden-planner"
      ],
      [
        "fill",
        "What should Claude Code",
        "Check the garden layout."
      ],
      [
        "click",
        "Review"
      ],
      [
        "wait",
        400
      ],
      [
        "click",
        "Start task"
      ],
      [
        "wait",
        1800
      ],
      [
        "eval",
        "if (!document.querySelector('.alerts-offer')) throw Error('Offer missing'); document.querySelector('.alerts-offer').scrollIntoView({block:'end'})"
      ]
    ]
  },
  {
    "name": "settings-light",
    "scale": 1,
    "settle": 1000,
    "steps": [
      [
        "eval",
        "window.__sim.device.notificationPermission('promptable')"
      ],
      [
        "click",
        "Settings"
      ],
      [
        "wait",
        450
      ],
      [
        "eval",
        "new Promise((resolve,reject)=>{let attempts=0;const check=()=>{const el=document.querySelector('#settings-notifications');if(el){el.scrollIntoView({block:'start'});resolve()}else if(++attempts>100)reject(Error('Notifications settings did not load'));else setTimeout(check,100)};check()})"
      ]
    ]
  },
  {
    "name": "receipt-light",
    "scale": 1,
    "settle": 1000,
    "steps": [
      [
        "eval",
        "window.__sim.permissions({transfers:false})"
      ],
      [
        "wait",
        1000
      ],
      [
        "eval",
        "window.__sim.device.notifications.push({id:'open',title:'Task alert',body:'tidewater-api',route:{kind:'attention',profileId:'sim-studio',attentionId:'0192f7a1-0000-7000-8000-000000000502'}}); window.__sim.device.open('open')"
      ],
      [
        "wait",
        1800
      ],
      [
        "eval",
        "if(!document.querySelector('.nav__tab:nth-child(3)[aria-current=page]')) throw Error('Wrong tab')"
      ],
      [
        "eval",
        "if(![...document.querySelectorAll('.bar__title')].some(x=>x.textContent==='Task receipt')) throw Error('Receipt not opened'); if([...document.querySelectorAll('button')].some(x=>x.textContent.includes('Reload evidence'))) throw Error('Futile reload')"
      ]
    ]
  },
  {
    "name": "approval-light",
    "scale": 1,
    "settle": 1000,
    "steps": [
      [
        "eval",
        "window.__sim.device.notifications.push({id:'open',title:'Task alert',body:'tidewater-api',route:{kind:'attention',profileId:'sim-studio',attentionId:'0192f7a1-0000-7000-8000-000000000501'}}); window.__sim.device.open('open')"
      ],
      [
        "wait",
        1800
      ],
      [
        "eval",
        "if(!document.querySelector('.nav__tab:nth-child(3)[aria-current=page]')) throw Error('Wrong tab')"
      ]
    ]
  },
  {
    "name": "missed-light",
    "scale": 1,
    "settle": 1000,
    "steps": [
      [
        "eval",
        "window.__sim.device.notificationPermission('promptable')"
      ],
      [
        "eval",
        "Object.defineProperty(document,'visibilityState',{configurable:true,value:'hidden'});document.dispatchEvent(new Event('visibilitychange'))"
      ],
      [
        "eval",
        "const h=window.__sim.host;const item=h.attention.find(a=>a.kind==='completed');for(const id of ['missed-1','missed-2']){h.emit({type:'attention_upserted',item:{...item,attention_id:id}})}"
      ],
      [
        "wait",
        350
      ],
      [
        "eval",
        "Object.defineProperty(document,'visibilityState',{configurable:true,value:'visible'});document.dispatchEvent(new Event('visibilitychange'))"
      ],
      [
        "wait",
        300
      ],
      [
        "eval",
        "if(document.querySelectorAll('.alerts-missed').length!==1)throw Error('Expected one missed-alert banner');if(!document.querySelector('.alerts-missed').textContent.includes('2 alerts'))throw Error('Missed count wrong')"
      ]
    ]
  },
