  {
    "name": "upload-collision",
    "scale": 1,
    "steps": [
      ["click", "Library"],
      ["wait", 650],
      ["click", "Transfers"],
      ["wait", 600],
      [
        "eval",
        "const input=document.querySelector(\".route:not(.is-hidden) input[type=file]\"); const dt=new DataTransfer(); dt.items.add(new File([new Uint8Array(3*1024*1024).map((_,i)=>i%251)],\"sample.bin\",{type:\"application/octet-stream\"})); input.files=dt.files; input.dispatchEvent(new Event(\"change\",{bubbles:true}));"
      ],
      ["wait", 250],
      ["clickSel", ".transfers-screen button.btn--primary"],
      ["wait", 1800],
      [
        "eval",
        "document.querySelector(\".route:not(.is-hidden) .transfer-row\")?.scrollIntoView({block:\"center\"})"
      ],
      ["shot", "first"],
      ["clickSel", ".transfers-screen button.btn--primary"],
      ["wait", 1800],
      [
        "eval",
        "document.querySelector(\".route:not(.is-hidden) .transfer-row\")?.scrollIntoView({block:\"center\"})"
      ],
      [
        "eval",
        "const t=window.__sim.host.transfers.filter(t=>t.name===\"sample.bin\"); if(t.length!==2 || !t[0].host_path.endsWith(\"sample (1).bin\")) throw new Error(\"Collision policy failed\")"
      ]
    ]
  },
  {
    "name": "upload-resume",
    "scale": 1,
    "steps": [
      ["click", "Library"],
      ["wait", 650],
      ["click", "Transfers"],
      ["wait", 600],
      ["eval", "window.__sim.transfers.chunkDelay(250)"],
      [
        "eval",
        "const input=document.querySelector(\".route:not(.is-hidden) input[type=file]\"); const dt=new DataTransfer(); dt.items.add(new File([new Uint8Array(3*1024*1024).map((_,i)=>i%251)],\"sample.bin\",{type:\"application/octet-stream\"})); input.files=dt.files; input.dispatchEvent(new Event(\"change\",{bubbles:true}));"
      ],
      ["wait", 250],
      ["clickSel", ".transfers-screen button.btn--primary"],
      ["wait", 400],
      [
        "eval",
        "document.querySelector(\".route:not(.is-hidden) .transfer-row\")?.scrollIntoView({block:\"center\"})"
